generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())

  leagues     LeagueMember[]
  commissions League[]       @relation("Commissioner")
  invitations Invitation[]   @relation("InvitedBy")
}

model League {
  id            String       @id @default(cuid())
  name          String
  description   String?
  season        Int
  commissionerId String
  commissioner  User         @relation("Commissioner", fields: [commissionerId], references: [id])
  maxTeams      Int          @default(10)
  status        LeagueStatus @default(SETUP)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  members      LeagueMember[]
  invitations  Invitation[]
  scoringRules ScoringRule[]
  rosterSlots  RosterSlot[]
}

enum LeagueStatus {
  SETUP
  DRAFTING
  ACTIVE
  ARCHIVED
}

model LeagueMember {
  id        String     @id @default(cuid())
  leagueId  String
  league    League     @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamName  String
  role      MemberRole @default(MEMBER)
  joinedAt  DateTime   @default(now())

  @@unique([leagueId, userId])
}

enum MemberRole {
  COMMISSIONER
  MEMBER
}

model Invitation {
  id          String           @id @default(cuid())
  leagueId    String
  league      League           @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  email       String
  token       String           @unique @default(uuid())
  status      InvitationStatus @default(PENDING)
  invitedById String
  invitedBy   User             @relation("InvitedBy", fields: [invitedById], references: [id])
  expiresAt   DateTime
  createdAt   DateTime         @default(now())

  @@unique([leagueId, email])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

model ScoringRule {
  id           String @id @default(cuid())
  leagueId     String
  league       League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  statCategory String
  pointValue   Float

  @@unique([leagueId, statCategory])
}

model RosterSlot {
  id       String   @id @default(cuid())
  leagueId String
  league   League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  position Position
  count    Int      @default(1)

  @@unique([leagueId, position])
}

enum Position {
  QB
  RB
  WR
  TE
  FLEX
  K
  DEF
  BENCH
}
